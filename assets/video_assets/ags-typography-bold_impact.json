{
  "schema": "ags.capcut.typography.v2",
  "preset_key": "bold_impact",
  "preset_name": "Bold Impact Poster (DelaGothic)",
  "canvas": {
    "width": 1080,
    "height": 1350,
    "aspect_ratio": "1080:1350"
  },
  "typography": {
    "headline_font_file": "DelaGothic-Bold.ttf",
    "body_font_file": "Montserrat-Bold.otf",
    "fallback_stack": "Bricolage Grotesque, Be Vietnam Pro, Plus Jakarta Sans, sans-serif",
    "line_height": 1.3,
    "letter_spacing_em": 0.02,
    "vietnamese_diacritic_safe": true,
    "unicode_coverage": "U+0102–U+1EF9 (134/134)"
  },
  "styling": {
    "treatment": "Heavy display block headline + two-tone keyword highlight",
    "scrim_bg": "rgba(14, 17, 22, 0.72)",
    "badge_bg": "#10B981",
    "headline_color": "#FFFFFF",
    "subtitle_color": "#E2E8F0",
    "drop_shadow": "0px 3px 8px rgba(0, 0, 0, 0.75)"
  },
  "copy": {
    "badge": "SỔ ĐO THỰC ĐỊA PRO",
    "title": "QUẢN LÝ DỰ ÁN VÀ SỔ ĐO",
    "subtitle": "Quản lý danh sách mốc và xuất dữ liệu Excel, KML một chạm"
  }
}